{
  "manifest_version": 3,
  "name": "Surfree",
  "version": "1.0.0",
  "icons": {
    "16": "images/surfree16.png",
    "32": "images/surfree32.png",
    "48": "images/surfree48.png",
    "128": "images/surfree128.png"
  },
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "storage",
    "tabs",
    "activeTab",
    "alarms",
    "management"
  ],
  "host_permissions": ["<all_urls>"],
  "declarative_net_request": {
    "rule_resources": [
      { "id": "easylist_ads", "enabled": true, "path": "rules/ads.json" },
      {
        "id": "easylist_trackers",
        "enabled": true,
        "path": "rules/trackers.json"
      },
      { "id": "easylist_popups", "enabled": true, "path": "rules/popups.json" }
    ]
  },
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "images/surfree16.png",
      "32": "images/surfree32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
