{
  "manifest_version": 3,
  "name": "CleanBrowse - Ad Blocker",
  "version": "1.0.0",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "storage",
    "tabs",
    "activeTab",
    "alarms"
  ],
  "host_permissions": ["<all_urls>"],
  "declarative_net_request": {
    "rule_resources": [
      { "id": "easylist_ads", "enabled": true, "path": "rules/ads.json" },
      {
        "id": "easylist_trackers",
        "enabled": true,
        "path": "rules/trackers.json"
      },
      { "id": "easylist_popups", "enabled": true, "path": "rules/popups.json" }
    ]
  },
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup/popup.html" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
